<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Phố Chợ Đêm & Chợ Nổi 2D - Bản Đồ 1,000 Quầy</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Canvas Confetti for Fireworks & Celebrations -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Nunito', sans-serif; user-select: none; }
        .custom-scrollbar::-webkit-scrollbar { width: 5px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.6); }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(245, 158, 11, 0.4); border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(245, 158, 11, 0.7); }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 h-screen overflow-hidden flex flex-col">

    <!-- TOAST NOTIFICATION CONTAINER -->
    <div id="toast-container" class="fixed top-5 left-1/2 transform -translate-x-1/2 z-50 flex flex-col items-center space-y-2 pointer-events-none"></div>

    <!-- MAIN HEADER -->
    <header class="bg-gradient-to-r from-amber-600 via-orange-600 to-red-600 px-4 py-2.5 text-white flex justify-between items-center shadow-lg border-b border-orange-500/30">
        <div class="flex items-center space-x-2.5">
            <span class="text-3xl animate-bounce">🏮</span>
            <div>
                <h1 class="text-base md:text-xl font-black tracking-wide uppercase leading-tight">Phố Chợ Đêm & Chợ Nổi 2D</h1>
                <p class="text-[11px] text-amber-100/90 font-medium">Bản Đồ 1,000 Quầy • Tự Do Dựng Quầy Trên Sông / Cây • Pháo Hoa Báo Đơn</p>
            </div>
        </div>

        <div class="flex items-center space-x-3">
            <div id="player-profile-badge" class="hidden flex items-center bg-black/40 px-3 py-1.5 rounded-2xl border border-amber-400/40 backdrop-blur-md">
                <span id="badge-user-avatar" class="text-xl mr-2"></span>
                <div class="text-left">
                    <div id="badge-user-name" class="text-xs font-bold text-amber-300"></div>
                    <div class="text-[10px] text-emerald-400 font-semibold">Ví: <span id="badge-user-balance">500,000</span>đ</div>
                </div>
            </div>
            <button onclick="openCreateStallModal()" class="bg-gradient-to-r from-amber-400 to-yellow-500 hover:from-amber-300 hover:to-yellow-400 text-slate-950 font-black px-3.5 py-2 rounded-xl text-xs shadow-md transition transform active:scale-95 flex items-center gap-1.5">
                <span>➕</span> Dựng Quầy Mới
            </button>
        </div>
    </header>

    <!-- SCREEN 1: CHARACTER SETUP (IF NO USER) -->
    <div id="screen-setup" class="flex-1 flex items-center justify-center p-4 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-900 via-slate-950 to-black">
        <div class="bg-slate-900/90 border border-amber-500/30 rounded-3xl p-6 md:p-8 max-w-md w-full shadow-2xl backdrop-blur-md text-center space-y-5">
            <div class="w-16 h-16 bg-gradient-to-tr from-amber-500 to-orange-500 rounded-2xl mx-auto flex items-center justify-center text-3xl shadow-lg shadow-orange-500/30 animate-pulse">
                🏮
            </div>
            <div>
                <h2 class="text-xl md:text-2xl font-black text-amber-400">Tham Gia Phố Chợ Đêm</h2>
                <p class="text-xs text-slate-400 mt-1">Chọn nhân vật để đi dạo, mua sắm hoặc tự tay mở quầy kinh doanh trên cạn hoặc ghe xuồng sông nước!</p>
            </div>

            <div class="space-y-4 text-left">
                <div>
                    <label class="block text-xs font-bold text-amber-300 mb-1">Tên Hiển Thị / Chủ Quầy:</label>
                    <input type="text" id="setup-name" placeholder="Ví dụ: Chị Ba Bánh Tráng" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500">
                </div>

                <div>
                    <label class="block text-xs font-bold text-amber-300 mb-1">Chọn Biểu Tượng (Avatar):</label>
                    <div class="grid grid-cols-6 gap-2" id="avatar-selector">
                        <button type="button" onclick="selectAvatar('👩‍🍳', this)" class="avatar-btn p-2.5 text-xl bg-slate-950 border-2 border-amber-500 rounded-xl flex items-center justify-center hover:bg-slate-800 transition">👩‍🍳</button>
                        <button type="button" onclick="selectAvatar('👨‍🌾', this)" class="avatar-btn p-2.5 text-xl bg-slate-950 border-2 border-slate-700 rounded-xl flex items-center justify-center hover:bg-slate-800 transition">👨‍🌾</button>
                        <button type="button" onclick="selectAvatar('👧', this)" class="avatar-btn p-2.5 text-xl bg-slate-950 border-2 border-slate-700 rounded-xl flex items-center justify-center hover:bg-slate-800 transition">👧</button>
                        <button type="button" onclick="selectAvatar('👦', this)" class="avatar-btn p-2.5 text-xl bg-slate-950 border-2 border-slate-700 rounded-xl flex items-center justify-center hover:bg-slate-800 transition">👦</button>
                        <button type="button" onclick="selectAvatar('🧑‍🎤', this)" class="avatar-btn p-2.5 text-xl bg-slate-950 border-2 border-slate-700 rounded-xl flex items-center justify-center hover:bg-slate-800 transition">🧑‍🎤</button>
                        <button type="button" onclick="selectAvatar('🧓', this)" class="avatar-btn p-2.5 text-xl bg-slate-950 border-2 border-slate-700 rounded-xl flex items-center justify-center hover:bg-slate-800 transition">🧓</button>
                    </div>
                </div>
            </div>

            <button onclick="saveUserProfile()" class="w-full bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-slate-950 font-black py-3 rounded-xl shadow-lg shadow-orange-600/30 transition transform active:scale-95 text-sm uppercase tracking-wider">
                Vào Chợ Ngay 🚀
            </button>
        </div>
    </div>

    <!-- SCREEN 2: MAIN GAME & MAP CANVAS -->
    <div id="screen-game" class="flex-1 hidden flex flex-col md:flex-row relative overflow-hidden">
        <!-- CANVAS CONTAINER -->
        <div class="flex-1 relative bg-slate-900 flex items-center justify-center overflow-hidden">
            <canvas id="marketCanvas" class="shadow-2xl cursor-crosshair"></canvas>

            <!-- CONTROLS OVERLAY (MOBILE & JOYPAD) -->
            <div class="absolute bottom-4 left-4 flex gap-2 md:hidden">
                <div class="grid grid-cols-3 gap-1 w-32 h-32 bg-black/40 p-2 rounded-2xl backdrop-blur-md border border-white/10">
                    <div></div>
                    <button ontouchstart="setTouchMove(0,-1)" touchend="setTouchMove(0,0)" class="bg-slate-800/80 rounded-xl flex items-center justify-center text-white active:bg-amber-600">⬆️</button>
                    <div></div>
                    <button ontouchstart="setTouchMove(-1,0)" touchend="setTouchMove(0,0)" class="bg-slate-800/80 rounded-xl flex items-center justify-center text-white active:bg-amber-600">⬅️</button>
                    <button ontouchstart="setTouchMove(0,1)" touchend="setTouchMove(0,0)" class="bg-slate-800/80 rounded-xl flex items-center justify-center text-white active:bg-amber-600">⬇️</button>
                    <button ontouchstart="setTouchMove(1,0)" touchend="setTouchMove(0,0)" class="bg-slate-800/80 rounded-xl flex items-center justify-center text-white active:bg-amber-600">➡️</button>
                </div>
            </div>

            <div class="absolute top-4 left-4 bg-slate-950/80 backdrop-blur-md px-3 py-2 rounded-2xl border border-slate-800 text-[11px] pointer-events-none space-y-0.5">
                <div class="text-amber-400 font-bold">💡 Hướng dẫn:</div>
                <div>• Dùng phím <b>W A S D</b> hoặc <b>Mũi tên</b> để di chuyển.</div>
                <div>• Ghé sát các quầy hàng (trên cạn hoặc ghe xuồng dưới sông) để mở quầy!</div>
                <div>• Quầy không có đơn trong <b>4 ngày</b> sẽ tự động bị thu hồi!</div>
            </div>
        </div>

        <!-- RIGHT SIDEBAR: STALL INFO / TABS -->
        <div id="stall-drawer" class="w-full md:w-96 bg-slate-950 border-t md:border-t-0 md:border-l border-slate-800 flex flex-col p-4 h-72 md:h-full">
            <div id="stall-empty-state" class="flex-1 flex flex-col items-center justify-center text-center text-slate-500 space-y-3 p-6">
                <span class="text-4xl">🛒</span>
                <p class="text-xs">Di chuyển nhân vật đến gần bất kỳ quầy hàng nào trên bản đồ để xem món, đặt hàng, nhắn tin hoặc quản lý!</p>
            </div>

            <div id="stall-content-state" class="hidden flex-1 flex flex-col space-y-3">
                <!-- STALL HEADER INFO -->
                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-3 flex justify-between items-center">
                    <div class="flex items-center space-x-2.5">
                        <span id="active-stall-icon" class="text-3xl">🍉</span>
                        <div>
                            <h3 id="active-stall-name" class="font-bold text-sm text-amber-400">Tên Quầy</h3>
                            <p id="active-stall-owner" class="text-[10px] text-slate-400">Chủ quầy: --</p>
                        </div>
                    </div>
                    <button onclick="closeStallDrawer()" class="text-slate-500 hover:text-white text-xs bg-slate-800 px-2.5 py-1 rounded-xl">✕ Đóng</button>
                </div>

                <!-- TAB CONTROLS -->
                <div class="flex border-b border-slate-800 text-xs font-bold">
                    <button id="tab-menu-btn" onclick="switchStallTab('menu')" class="flex-1 py-2 text-amber-400 border-b-2 border-amber-400 transition">🛍️ Món Hàng</button>
                    <button id="tab-orders-btn" onclick="switchStallTab('orders')" class="flex-1 py-2 text-slate-400 transition">📋 Đơn Hàng (<span id="orders-count-badge">0</span>)</button>
                    <button id="tab-visitors-btn" onclick="switchStallTab('visitors')" class="flex-1 py-2 text-slate-400 transition">👥 Khách (<span id="visitors-count-badge">0</span>)</button>
                    <button id="tab-chat-btn" onclick="switchStallTab('chat')" class="flex-1 py-2 text-slate-400 transition">💬 Nhắn Tin</button>
                </div>

                <!-- TAB 1: MENU ITEMS -->
                <div id="stall-tab-menu" class="flex-1 overflow-y-auto custom-scrollbar space-y-3 pr-1">
                    <!-- Dynamic items -->
                </div>

                <!-- TAB 2: ORDERS -->
                <div id="stall-tab-orders" class="flex-1 hidden overflow-y-auto custom-scrollbar space-y-2 pr-1">
                    <!-- Dynamic orders -->
                </div>

                <!-- TAB 3: VISITORS & ENTICING -->
                <div id="stall-tab-visitors" class="flex-1 hidden overflow-y-auto custom-scrollbar space-y-2 pr-1">
                    <!-- Visitors list -->
                </div>

                <!-- TAB 4: CHAT WITH SELLER -->
                <div id="stall-tab-chat" class="flex-1 hidden flex flex-col h-72 border border-slate-800 rounded-2xl p-3 bg-slate-900/50">
                    <div id="chat-messages" class="flex-1 overflow-y-auto custom-scrollbar space-y-2 text-xs mb-2 p-1">
                        <div class="text-slate-500 text-[10px] text-center">--- Trò chuyện trực tiếp cùng chủ quầy ---</div>
                    </div>
                    <div class="flex gap-2">
                        <input type="text" id="chat-input-text" placeholder="Nhập tin nhắn..." class="flex-1 bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-500">
                        <button onclick="sendStallChatMessage()" class="bg-amber-600 hover:bg-amber-500 text-white font-bold px-4 py-2 rounded-xl text-xs transition">Gửi</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL: CREATE STALL (DỰNG QUẦY MỚI) -->
    <div id="modal-create-stall" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-amber-500/40 rounded-3xl p-6 max-w-lg w-full shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto custom-scrollbar">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h3 class="font-extrabold text-base text-amber-400 flex items-center gap-2"><span>🏮</span> Dựng Quầy Hàng Mới (1,000 Slots)</h3>
                <button onclick="closeCreateStallModal()" class="text-slate-400 hover:text-white text-sm">✕</button>
            </div>

            <div class="space-y-3 text-xs">
                <div>
                    <label class="block font-bold text-amber-300 mb-1">Tên Quầy Hàng:</label>
                    <input type="text" id="new-stall-name" placeholder="Ví dụ: Quầy Trà Sữa & Bánh Ngọt" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-emerald-500">
                </div>

                <div>
                    <label class="block font-bold text-amber-300 mb-1">Slogan / Câu Giới Thiệu Thu Hút Khách:</label>
                    <input type="text" id="new-stall-slogan" placeholder="Ví dụ: Ngon khó cưỡng • Giảm 10% hôm nay!" maxlength="40" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-emerald-500">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-bold text-amber-300 mb-1">Biểu tượng Quầy (Emoji):</label>
                        <select id="new-stall-icon" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-emerald-500">
                            <option value="🍉">🍉 Trái cây / Dưa hấu</option>
                            <option value="🧋">🧋 Trà sữa / Đồ uống</option>
                            <option value="🍜">🍜 Phở / Hủ tiếu / Mì</option>
                            <option value="🥞">🥞 Bánh xèo / Bánh khọt</option>
                            <option value="💍">💍 Trang sức bạc / Vàng</option>
                            <option value="🌸">🌸 Hoa tươi / Quà lưu niệm</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-bold text-amber-300 mb-1">QR Chuyển Khoản (VietQR):</label>
                        <input type="file" id="new-stall-qr-file" accept="image/*" onchange="previewStallQR(event)" class="w-full text-[10px] text-slate-400 file:mr-2 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-[10px] file:font-semibold file:bg-amber-600 file:text-white hover:file:bg-amber-500 cursor-pointer">
                    </div>
                </div>

                <div class="border-t border-slate-800 pt-3 space-y-2">
                    <div class="font-bold text-amber-400">🛍️ Sản Phẩm Đầu Tiên Tại Quầy:</div>
                    <div class="grid grid-cols-2 gap-2">
                        <input type="text" id="new-item-name" placeholder="Tên món (VD: Trà sữa trân châu)" class="bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-emerald-500">
                        <input type="number" id="new-item-price" placeholder="Giá tiền (VNĐ)" class="bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-emerald-500">
                    </div>
                    <input type="text" id="new-item-desc" placeholder="Mô tả ngắn món ăn / sản phẩm" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-emerald-500">
                    <div>
                        <label class="block text-slate-400 text-[10px] mb-1">Hình ảnh sản phẩm (Tùy chọn):</label>
                        <input type="file" id="new-item-img-file" accept="image/*" onchange="previewProductImg(event)" class="w-full text-[10px] text-slate-400 file:mr-2 file:py-1 file:px-2 file:rounded-xl file:border-0 file:text-[10px] file:font-semibold file:bg-slate-800 file:text-amber-400 hover:file:bg-slate-700 cursor-pointer">
                    </div>
                </div>
            </div>

            <div class="flex justify-end gap-2 pt-2 border-t border-slate-800">
                <button onclick="closeCreateStallModal()" class="bg-slate-800 hover:bg-slate-700 px-4 py-2 rounded-xl text-xs font-bold text-white transition">Hủy</button>
                <button onclick="submitNewStallCreation()" class="bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 text-slate-950 font-black px-5 py-2 rounded-xl text-xs shadow-lg transition">Xác Nhận Dựng Quầy 🚀</button>
            </div>
        </div>
    </div>

    <!-- MODAL: CHECKOUT & ORDER PLACEMENT -->
    <div id="modal-checkout" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-amber-500/40 rounded-3xl p-6 max-w-sm w-full shadow-2xl space-y-4">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h3 class="font-extrabold text-sm text-amber-400">📦 Đặt Hàng / Thanh Toán</h3>
                <button onclick="closeCheckoutModal()" class="text-slate-400 hover:text-white text-sm">✕</button>
            </div>

            <div id="checkout-item-summary" class="bg-slate-950 p-3 rounded-2xl border border-slate-800 text-xs space-y-1">
                <!-- Item info -->
            </div>

            <div class="space-y-3 text-xs">
                <div>
                    <label class="block font-bold text-amber-300 mb-1">Họ và Tên Người Nhận:</label>
                    <input type="text" id="checkout-name" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-amber-500">
                </div>
                <div>
                    <label class="block font-bold text-amber-300 mb-1">Số Điện Thoại:</label>
                    <input type="text" id="checkout-phone" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-amber-500">
                </div>
                <div>
                    <label class="block font-bold text-amber-300 mb-1">Địa Chỉ Nhận Hàng (Hoặc vị trí tại chợ):</label>
                    <input type="text" id="checkout-address" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-amber-500">
                </div>
                <div>
                    <label class="block font-bold text-amber-300 mb-1">Phương Thức Thanh Toán:</label>
                    <div class="grid grid-cols-2 gap-2">
                        <label class="flex items-center gap-2 bg-slate-950 border border-slate-700 p-2.5 rounded-xl cursor-pointer">
                            <input type="radio" name="payment_type" value="wallet" checked class="text-amber-500">
                            <span>Trừ Tiền Ví</span>
                        </label>
                        <label class="flex items-center gap-2 bg-slate-950 border border-slate-700 p-2.5 rounded-xl cursor-pointer">
                            <input type="radio" name="payment_type" value="qr" class="text-amber-500">
                            <span>Quét Mã QR</span>
                        </label>
                    </div>
                </div>
            </div>

            <button onclick="submitOrderCheckout()" class="w-full bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 text-white font-black py-2.5 rounded-xl shadow-lg shadow-emerald-600/30 text-xs transition uppercase">
                Xác Nhận Đặt Đơn Ngay 🎆
            </button>
        </div>
    </div>

    <!-- MODAL: PRINTABLE BILL (HOÁ ĐƠN THANH TOÁN) -->
    <div id="modal-bill" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white text-slate-900 rounded-3xl p-6 max-w-sm w-full shadow-2xl space-y-4 font-mono">
            <div class="text-center border-b border-dashed border-slate-300 pb-3">
                <h3 class="font-black text-base uppercase text-orange-600">🏮 HÓA ĐƠN CHỢ ĐÊM 🏮</h3>
                <p class="text-[10px] text-slate-500">Xác nhận đơn hàng thành công • Bắn pháo hoa báo quầy!</p>
            </div>
            <div id="bill-details" class="text-xs space-y-1.5">
                <!-- Bill content -->
            </div>
            <div class="border-t border-dashed border-slate-300 pt-3 text-center text-[10px] text-slate-500">
                Cảm ơn quý khách đã ủng hộ phiên chợ miền Tây! ❤️
            </div>
            <button onclick="closePrintableBill()" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-2 rounded-xl text-xs transition font-sans">
                Đóng Hoá Đơn
            </button>
        </div>
    </div>

    <script>
        // --- LOCAL STORAGE & APP STATE ---
        let currentUser = JSON.parse(localStorage.getItem('nightmarket_user')) || null;
        let userBalance = parseInt(localStorage.getItem('nightmarket_balance')) || 500000;
        let selectedAvatarIcon = '👩‍🍳';
        let uploadedStallQRBase64 = '';
        let uploadedProductBase64 = '';

        // Default Market Stalls (Supporting up to 1,000 stalls)
        let stallsList = JSON.parse(localStorage.getItem('nightmarket_stalls')) || [
            {
                id: 1,
                ownerName: 'Bác Ba Nông Dân',
                ownerAvatar: '👨‍🌾',
                stallName: 'Quầy Trái Cây Miền Tây',
                slogan: '🍉 Dưa ngọt lịm mọng nước đây!',
                icon: '🍉',
                qrCode: 'https://img.vietqr.io/image/MB-06399669996699-compact2.png?accountName=LAM%20DIEM%20HANG',
                x: 220,
                y: 220,
                lastSaleTime: Date.now(),
                orders: [],
                items: [
                    { id: 101, name: 'Dưa Hấu Ngọt Ruột Đỏ', price: 40000, desc: 'Mọng nước ruột đỏ tươi', img: 'https://images.unsplash.com/photo-1587049352847-4a222e784d38?w=200' },
                    { id: 102, name: 'Xoài Cát Hòa Lộc', price: 65000, desc: 'Xoài Cát Hòa Lộc thơm lừng', img: '' }
                ]
            },
            {
                id: 2,
                ownerName: 'Tiệm Trà Miu Miu',
                ownerAvatar: '👩‍🍳',
                stallName: 'Góc Trà Sữa Thuyền Rồng',
                slogan: '🧋 Đậm vị trà, béo vị sữa!',
                icon: '🧋',
                qrCode: '',
                x: 520,
                y: 320,
                lastSaleTime: Date.now(),
                orders: [],
                items: [
                    { id: 201, name: 'Trà Sữa Matcha Trân Châu', price: 35000, desc: 'Béo ngậy đậm vị trà', img: '' },
                    { id: 202, name: 'Bánh Tráng Trộn Trứng Cút', price: 25000, desc: 'Chua cay mặn ngọt chuẩn vị', img: '' }
                ]
            }
        ];

        // CHECK 4 DAYS EXPIRATION (96 HOURS = 345600000 ms)
        function checkAndConfiscateExpiredStalls() {
            const FOUR_DAYS_MS = 4 * 24 * 60 * 60 * 1000;
            const now = Date.now();
            let hasChanges = false;

            stallsList = stallsList.filter(stall => {
                const timeDiff = now - (stall.lastSaleTime || stall.id);
                if (timeDiff > FOUR_DAYS_MS) {
                    hasChanges = true;
                    showToastNotification(`⚠️ Quầy "${stall.stallName}" của ${stall.ownerName} bị thu hồi do 4 ngày không ra đơn!`);
                    return false;
                }
                return true;
            });

            if (hasChanges) {
                localStorage.setItem('nightmarket_stalls', JSON.stringify(stallsList));
            }
        }

        let activeStall = null;
        let pendingCheckoutItem = null;

        // Canvas Game Variables
        let canvas, ctx;
        let playerPos = { x: 380, y: 420, vx: 0, vy: 0, speed: 4.5 };
        let keysPressed = {};
        let touchDir = { x: 0, y: 0 };
        let animationFrameId = null;

        // --- APP CONTROLLER ---
        function initApp() {
            checkAndConfiscateExpiredStalls();
            updateBadgeUI();
            if (!currentUser) {
                renderCharacterSelectScreen();
            } else {
                renderGameCanvasScreen();
            }
        }

        function renderCharacterSelectScreen() {
            document.getElementById('screen-setup').classList.remove('hidden');
            document.getElementById('screen-game').classList.add('hidden');
            document.getElementById('player-profile-badge').classList.add('hidden');
        }

        function selectAvatar(icon, btnElement) {
            selectedAvatarIcon = icon;
            document.querySelectorAll('.avatar-btn').forEach(b => b.classList.replace('border-amber-500', 'border-slate-700'));
            btnElement.classList.replace('border-slate-700', 'border-amber-500');
        }

        function saveUserProfile() {
            const nameInput = document.getElementById('setup-name').value.trim();
            if (!nameInput) return alert("Vui lòng nhập tên hiển thị của bạn!");

            currentUser = {
                name: nameInput,
                avatarIcon: selectedAvatarIcon,
                color: '#f59e0b'
            };

            localStorage.setItem('nightmarket_user', JSON.stringify(currentUser));
            renderGameCanvasScreen();
        }

        function updateBadgeUI() {
            if (!currentUser) return;
            document.getElementById('player-profile-badge').classList.remove('hidden');
            document.getElementById('badge-user-name').innerText = currentUser.name;
            document.getElementById('badge-user-avatar').innerText = currentUser.avatarIcon;
            document.getElementById('badge-user-balance').innerText = userBalance.toLocaleString('vi-VN');
        }

        function renderGameCanvasScreen() {
            document.getElementById('screen-setup').classList.add('hidden');
            document.getElementById('screen-game').classList.remove('hidden');
            updateBadgeUI();

            canvas = document.getElementById('marketCanvas');
            ctx = canvas.getContext('2d');
            resizeCanvas();
            window.addEventListener('resize', resizeCanvas);

            // Setup Controls
            window.addEventListener('keydown', e => keysPressed[e.key.toLowerCase()] = true);
            window.addEventListener('keyup', e => keysPressed[e.key.toLowerCase()] = false);

            if (!animationFrameId) {
                gameLoop();
            }
        }

        function resizeCanvas() {
            const container = canvas.parentElement;
            canvas.width = container.clientWidth;
            canvas.height = container.clientHeight;
        }

        function setTouchMove(dx, dy) {
            touchDir = { x: dx, y: dy };
        }

        // --- GAME LOOP & PHYSICS ---
        function updatePlayerPosition() {
            let dx = 0, dy = 0;
            if (keysPressed['w'] || keysPressed['arrowup']) dy -= 1;
            if (keysPressed['s'] || keysPressed['arrowdown']) dy += 1;
            if (keysPressed['a'] || keysPressed['arrowleft']) dx -= 1;
            if (keysPressed['d'] || keysPressed['arrowright']) dx += 1;

            if (touchDir.x !== 0 || touchDir.y !== 0) {
                dx = touchDir.x;
                dy = touchDir.y;
            }

            if (dx !== 0 && dy !== 0) {
                dx *= 0.7071;
                dy *= 0.7071;
            }

            playerPos.x += dx * playerPos.speed;
            playerPos.y += dy * playerPos.speed;

            // Boundary constraints
            playerPos.x = Math.max(30, Math.min(canvas.width - 30, playerPos.x));
            playerPos.y = Math.max(30, Math.min(canvas.height - 30, playerPos.y));

            // Proximity Check to Stalls
            checkStallProximity();
        }

        function checkStallProximity() {
            let nearestStall = null;
            let minDist = 55; //
